{
 "_note": "Study sheet for the course's calculus fundamentals (not from QSS). LaTeX: \\( \\) inline, $$ $$ display.",
 "rules": [
  {
   "name": "Constant, constant multiple, sum",
   "rule": "$$\\frac{d}{dx}c = 0, \\qquad \\frac{d}{dx}\\big[c\\,f(x)\\big] = c\\,f'(x), \\qquad \\frac{d}{dx}\\big[f(x) \\pm g(x)\\big] = f'(x) \\pm g'(x)$$",
   "example": "\\(\\frac{d}{dx}\\left(3x^2 + 5x - 7\\right) = 6x + 5\\)"
  },
  {
   "name": "Power rule",
   "rule": "$$\\frac{d}{dx}x^n = n\\,x^{n-1} \\quad \\text{(any real } n\\text{)}$$",
   "example": "\\(\\frac{d}{dx}4x^{-2} = -8x^{-3}\\); \\(\\frac{d}{dx}\\sqrt{x} = \\frac{d}{dx}x^{1/2} = \\frac{1}{2}x^{-1/2}\\)"
  },
  {
   "name": "Product rule",
   "rule": "$$\\frac{d}{dx}\\big[f(x)\\,g(x)\\big] = f'(x)\\,g(x) + f(x)\\,g'(x)$$",
   "example": "\\(\\frac{d}{dx}\\left[(x^2+1)(3x-1)\\right] = 2x(3x-1) + 3(x^2+1) = 9x^2 - 2x + 3\\)"
  },
  {
   "name": "Quotient rule",
   "rule": "$$\\frac{d}{dx}\\left[\\frac{f(x)}{g(x)}\\right] = \\frac{f'(x)\\,g(x) - f(x)\\,g'(x)}{g(x)^2}$$ Order matters: “low d-high minus high d-low, over low squared.”",
   "example": "\\(\\frac{d}{dx}\\,\\frac{2x+1}{x+3} = \\frac{2(x+3) - (2x+1)}{(x+3)^2} = \\frac{5}{(x+3)^2}\\)"
  },
  {
   "name": "Chain rule",
   "rule": "$$\\frac{d}{dx}f\\big(g(x)\\big) = f'\\big(g(x)\\big)\\,g'(x)$$ Derivative of the outside (evaluated at the inside) times the derivative of the inside.",
   "example": "\\(\\frac{d}{dx}(a - bx)^2 = 2(a - bx)(-b) = -2b(a - bx)\\)"
  },
  {
   "name": "Partial derivative",
   "rule": "$$\\frac{\\partial f}{\\partial x}: \\text{ differentiate in } x \\text{, treating every other variable as a constant}$$",
   "example": "\\(f = 3x^2y + 2xy + y^2\\): \\(\\frac{\\partial f}{\\partial x} = 6xy + 2y\\), \\(\\frac{\\partial f}{\\partial y} = 3x^2 + 2x + 2y\\)"
  },
  {
   "name": "First-order condition",
   "rule": "$$f'(x^*) = 0 \\quad \\text{(with several variables: every } \\tfrac{\\partial f}{\\partial x_j} = 0\\text{)}$$ Solve for the critical point(s).",
   "example": "\\(f(x) = 2x^2 - 12x + 1\\): \\(f'(x) = 4x - 12 = 0 \\Rightarrow x^* = 3\\)"
  },
  {
   "name": "Second derivative test",
   "rule": "$$f''(x^*) > 0 \\Rightarrow \\text{minimum}, \\qquad f''(x^*) < 0 \\Rightarrow \\text{maximum}, \\qquad f''(x^*) = 0 \\Rightarrow \\text{inconclusive}$$",
   "example": "\\(f''(x) = 4 > 0\\), so \\(x^* = 3\\) is a minimum"
  },
  {
   "name": "The mean minimizes squared deviations",
   "rule": "$$S(c) = \\sum_{i=1}^{n}(x_i - c)^2, \\qquad \\frac{dS}{dc} = -2\\sum_{i=1}^{n}(x_i - c) = 0 \\;\\Rightarrow\\; c = \\bar{x}$$",
   "example": "For \\(x = \\{2, 4, 9\\}\\), \\(S(c)\\) is smallest at \\(c = 5\\)"
  },
  {
   "name": "Marginal effect in a linear model",
   "rule": "$$Y = \\alpha + \\beta X \\;\\Rightarrow\\; \\frac{dY}{dX} = \\beta; \\qquad \\frac{\\partial Y}{\\partial X_j} = \\beta_j \\text{ holding the other predictors fixed}$$",
   "example": "\\(\\hat{Y} = -0.31 + 0.66X\\): each 1-unit rise in \\(X\\) raises \\(\\hat{Y}\\) by \\(0.66\\)"
  },
  {
   "name": "Marginal effect with an interaction",
   "rule": "$$Y = \\alpha + \\beta_1X_1 + \\beta_2X_2 + \\beta_3X_1X_2 \\;\\Rightarrow\\; \\frac{\\partial Y}{\\partial X_1} = \\beta_1 + \\beta_3X_2$$",
   "example": "\\(\\beta_1 = 0.05,\\ \\beta_3 = 0.001\\): at \\(X_2 = 60\\), \\(\\frac{\\partial Y}{\\partial X_1} = 0.05 + 0.06 = 0.11\\)"
  },
  {
   "name": "Marginal effect with a quadratic",
   "rule": "$$Y = \\alpha + \\beta_1X + \\beta_2X^2 \\;\\Rightarrow\\; \\frac{dY}{dX} = \\beta_1 + 2\\beta_2X, \\qquad X^* = -\\frac{\\beta_1}{2\\beta_2} \\;\\text{(a peak if } \\beta_2 < 0\\text{)}$$",
   "example": "\\(\\hat{Y} = \\alpha + 0.012\\,\\text{Age} - 0.0001\\,\\text{Age}^2\\): peak at \\(\\text{Age}^* = \\frac{0.012}{0.0002} = 60\\)"
  },
  {
   "name": "Least squares via calculus",
   "rule": "$$\\text{SSR}(\\hat{\\alpha}, \\hat{\\beta}) = \\sum_{i=1}^{n}\\big(Y_i - \\hat{\\alpha} - \\hat{\\beta}X_i\\big)^2$$ $$\\frac{\\partial\\,\\text{SSR}}{\\partial\\hat{\\alpha}} = -2\\sum_{i=1}^{n}\\big(Y_i - \\hat{\\alpha} - \\hat{\\beta}X_i\\big) = 0 \\;\\Rightarrow\\; \\hat{\\alpha} = \\bar{Y} - \\hat{\\beta}\\bar{X}$$ $$\\frac{\\partial\\,\\text{SSR}}{\\partial\\hat{\\beta}} = -2\\sum_{i=1}^{n}X_i\\big(Y_i - \\hat{\\alpha} - \\hat{\\beta}X_i\\big) = 0 \\;\\Rightarrow\\; \\hat{\\beta} = \\frac{\\sum_{i}(X_i - \\bar{X})(Y_i - \\bar{Y})}{\\sum_{i}(X_i - \\bar{X})^2}$$",
   "example": "The first condition also means the residuals sum to zero and the line passes through \\((\\bar{X}, \\bar{Y})\\) (QSS eqs. 4.6 and 4.7)"
  },
  {
   "name": "Summation algebra",
   "rule": "$$\\sum_i a\\,x_i = a\\sum_i x_i, \\quad \\sum_i (x_i + y_i) = \\sum_i x_i + \\sum_i y_i, \\quad \\sum_{i=1}^{n} c = nc, \\quad \\sum_i x_i = n\\bar{x}, \\quad \\sum_i (x_i - \\bar{x}) = 0$$",
   "example": "\\(\\sum_i\\big(Y_i - \\hat{\\alpha} - \\hat{\\beta}X_i\\big) = n\\bar{Y} - n\\hat{\\alpha} - \\hat{\\beta}\\,n\\bar{X}\\)"
  }
 ]
}